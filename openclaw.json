{
  "project": {
    "name": "pm-team",
    "version": "3.0.0",
    "description": "产品全生命周期多角色协作团队"
  },
  "logs": {
    "path": "./logs",
    "tasks": "./logs/tasks",
    "workflow": "./logs/workflow",
    "approvals": "./logs/approvals",
    "reports": "./logs/reports",
    "retention": {
      "tasks": 30,
      "workflow": 90,
      "approvals": 365,
      "reports": 365
    },
    "format": "structured",
    "level": "info"
  },
  "workspaces": {
    "path": "./workspaces",
    "versioning": {
      "enabled": true,
      "maxVersions": 3,
      "archivePath": "archive"
    },
    "naming": {
      "artifacts": "{task-id}-{artifact-type}-{version}.{ext}",
      "temp": "temp-{timestamp}-{name}.{ext}"
    }
  },
  "agents": {
    "list": [
      {
        "id": "director",
        "name": "项目总监",
        "workspace": "./workspaces/director",
        "configPath": "./agents/director/AGENT.md",
        "description": "负责整个产品生命周期的任务调度和协调，是团队的中央大脑"
      },
      {
        "id": "requirement-analyst",
        "name": "需求分析师",
        "workspace": "./workspaces/requirement-analyst",
        "configPath": "./agents/requirement-analyst/AGENT.md",
        "description": "负责需求调研、分析和文档编写，输出PRD文档"
      },
      {
        "id": "architect",
        "name": "技术架构师",
        "workspace": "./workspaces/architect",
        "configPath": "./agents/architect/AGENT.md",
        "description": "负责系统架构设计和技术选型，输出技术架构方案"
      },
      {
        "id": "product-designer",
        "name": "产品设计师",
        "workspace": "./workspaces/product-designer",
        "configPath": "./agents/product-designer/AGENT.md",
        "description": "负责产品设计、原型设计和交互设计，输出原型图和交互文档"
      },
      {
        "id": "ui-designer",
        "name": "UI设计师",
        "workspace": "./workspaces/ui-designer",
        "configPath": "./agents/ui-designer/AGENT.md",
        "description": "负责视觉设计、设计规范和切图标注，输出高保真设计稿"
      },
      {
        "id": "database-designer",
        "name": "数据库设计师",
        "workspace": "./workspaces/database-designer",
        "configPath": "./agents/database-designer/AGENT.md",
        "description": "负责数据库架构设计和数据模型设计，输出数据库设计方案"
      },
      {
        "id": "backend-developer",
        "name": "后端工程师",
        "workspace": "./workspaces/backend-developer",
        "configPath": "./agents/backend-developer/AGENT.md",
        "description": "负责后端服务开发和API设计，输出后端代码和API"
      },
      {
        "id": "frontend-developer",
        "name": "前端工程师",
        "workspace": "./workspaces/frontend-developer",
        "configPath": "./agents/frontend-developer/AGENT.md",
        "description": "负责前端页面开发和性能优化，输出前端代码"
      },
      {
        "id": "security-engineer",
        "name": "安全工程师",
        "workspace": "./workspaces/security-engineer",
        "configPath": "./agents/security-engineer/AGENT.md",
        "description": "负责安全设计和安全审计，输出安全方案和审计报告"
      },
      {
        "id": "code-reviewer",
        "name": "代码审查员",
        "workspace": "./workspaces/code-reviewer",
        "configPath": "./agents/code-reviewer/AGENT.md",
        "description": "负责代码质量审查、安全检查和最佳实践建议"
      },
      {
        "id": "tester",
        "name": "测试工程师",
        "workspace": "./workspaces/tester",
        "configPath": "./agents/tester/AGENT.md",
        "description": "负责测试用例设计、自动化测试和质量验证"
      },
      {
        "id": "operations",
        "name": "运维工程师",
        "workspace": "./workspaces/operations",
        "configPath": "./agents/operations/AGENT.md",
        "description": "负责部署、监控和线上环境维护"
      },
      {
        "id": "tech-writer",
        "name": "技术文档工程师",
        "workspace": "./workspaces/tech-writer",
        "configPath": "./agents/tech-writer/AGENT.md",
        "description": "负责技术文档和API文档编写，输出高质量文档"
      }
    ]
  },
  "skills": {
    "paths": [
      "./skills"
    ],
    "bindings": [
      {
        "skill": "task-tracker",
        "primaryAgent": "director",
        "allAgents": true,
        "usage": "Director 创建/调度/汇总任务；各 Agent 上报进度与状态"
      },
      {
        "skill": "smart-scheduler",
        "primaryAgent": "director",
        "consumers": ["architect", "backend-developer", "frontend-developer"],
        "usage": "Director 调度决策；架构师/开发者接收调度结果"
      },
      {
        "skill": "quality-assessor",
        "primaryAgent": "director",
        "consumers": ["code-reviewer", "tester", "security-engineer"],
        "usage": "Director 质量门禁；审查员/测试/安全触发评估"
      },
      {
        "skill": "multi-project-manager",
        "primaryAgent": "director",
        "usage": "Director 跨项目资源协调与优先级决策"
      },
      {
        "skill": "notification-system",
        "primaryAgent": "director",
        "usage": "阶段完成/错误/审批事件通知"
      },
      {
        "skill": "agent-communication",
        "primaryAgent": "director",
        "allAgents": true,
        "usage": "Agent 间同步/异步/广播通信"
      },
      {
        "skill": "dashboard-visualizer",
        "primaryAgent": "director",
        "usage": "实时可视化任务看板与工作流"
      },
      {
        "skill": "automation-tester",
        "primaryAgent": "tester",
        "consumers": ["code-reviewer"],
        "usage": "Tester 执行测试与覆盖率分析；Code-reviewer 查阅测试结果辅助审查"
      },
      {
        "skill": "database-design-toolkit",
        "primaryAgent": "database-designer",
        "usage": "Database-designer 进行 ER 图生成、DDL 生成、索引优化与数据迁移"
      },
      {
        "skill": "requirement-analyzer",
        "primaryAgent": "requirement-analyst",
        "consumers": ["director"],
        "usage": "Requirement-analyst 需求文档解析与拆解；Director 查阅需求优先级辅助决策"
      },
      {
        "skill": "frontend-builder",
        "primaryAgent": "frontend-developer",
        "usage": "Frontend-developer 前端代码生成与组件库管理"
      },
      {
        "skill": "security-scanner",
        "primaryAgent": "security-engineer",
        "consumers": ["code-reviewer"],
        "usage": "Security-engineer 漏洞扫描与合规检查；Code-reviewer 查阅安全扫描结果"
      },
      {
        "skill": "cicd-pipeline",
        "primaryAgent": "operations",
        "consumers": ["backend-developer", "frontend-developer", "tester"],
        "usage": "Operations 流水线编排与部署执行；开发者/测试查阅构建与测试结果"
      },
      {
        "skill": "code-analyzer",
        "primaryAgent": "code-reviewer",
        "consumers": ["architect", "backend-developer", "frontend-developer"],
        "usage": "Code-reviewer 代码质量分析；架构师/开发者查阅复杂度与重复代码"
      },
      {
        "skill": "ui-design-toolkit",
        "primaryAgent": "ui-designer",
        "usage": "UI-designer 设计系统生成与组件模板库管理"
      },
      {
        "skill": "design-delivery",
        "primaryAgent": "ui-designer",
        "consumers": ["frontend-developer"],
        "usage": "UI-designer 生成规范文档/切图/Token；Frontend-developer 消费设计 Token"
      },
      {
        "skill": "interactive-prototype",
        "primaryAgent": "product-designer",
        "usage": "Product-designer 创建可交互高保真原型"
      },
      {
        "skill": "prototype-visualizer",
        "primaryAgent": "product-designer",
        "consumers": ["director"],
        "usage": "Product-designer 生成流程图与可视化；Director 查阅流程图辅助评审"
      },
      {
        "skill": "monitor-alert",
        "primaryAgent": "operations",
        "usage": "Operations 系统监控、性能指标跟踪与自动告警"
      },
      {
        "skill": "deployer",
        "primaryAgent": "operations",
        "consumers": ["tester"],
        "usage": "Operations 部署后健康检查与验证；Tester 验证部署结果。部署执行/回滚委托 cicd-pipeline"
      },
      {
        "skill": "api-mock",
        "primaryAgent": "frontend-developer",
        "consumers": ["backend-developer", "tester"],
        "usage": "Frontend-developer 联调时 Mock API；Backend-developer 定义接口契约；Tester 验证 Mock 一致性"
      },
      {
        "skill": "data-analytics",
        "primaryAgent": "product-designer",
        "consumers": ["director"],
        "usage": "Product-designer 数据洞察辅助决策；Director 查阅业务指标"
      },
      {
        "skill": "knowledge-base",
        "primaryAgent": "tech-writer",
        "consumers": ["all"],
        "usage": "Tech-writer 维护知识库；所有 Agent 检索项目知识与文档"
      }
    ]
  },
  "bindings": [
    {
      "agentId": "director",
      "match": {
        "channel": "default",
        "purpose": "product-lifecycle"
      }
    }
  ],
  "workflow": {
    "name": "产品全生命周期协作流程",
    "description": "从需求分析到上线运维的完整产品开发流程",
    "stages": [
      {
        "name": "需求分析",
        "agent": "requirement-analyst",
        "output": "PRD文档",
        "description": "深入理解用户需求，输出产品需求文档"
      },
      {
        "name": "用户故事设计",
        "agent": "requirement-analyst",
        "output": "用户故事列表",
        "description": "将需求转化为标准格式的用户故事，符合INVEST原则"
      },
      {
        "name": "验收标准定义",
        "agent": "requirement-analyst",
        "output": "验收标准文档",
        "description": "为每个用户故事定义清晰的验收标准(Gherkin格式)"
      },
      {
        "name": "需求评审",
        "agent": "director",
        "output": "需求评审报告",
        "description": "评审PRD文档、用户故事和验收标准，确认完整性和可行性",
        "requireApproval": true
      },
      {
        "name": "架构设计",
        "agent": "architect",
        "output": "技术架构方案",
        "description": "设计系统架构和技术选型",
        "requireApproval": true
      },
      {
        "name": "数据库设计",
        "agent": "database-designer",
        "output": "数据库设计方案",
        "description": "设计数据模型和数据库架构"
      },
      {
        "name": "产品设计",
        "agent": "product-designer",
        "output": "原型图/交互文档",
        "description": "设计产品原型和交互流程",
        "parallel": true
      },
      {
        "name": "UI设计",
        "agent": "ui-designer",
        "output": "设计稿/切图",
        "description": "设计高保真视觉稿和设计资源",
        "dependsOn": "产品设计"
      },
      {
        "name": "设计评审",
        "agent": "director",
        "output": "设计评审报告",
        "description": "评审设计方案，确认满足需求",
        "requireApproval": true
      },
      {
        "name": "后端开发",
        "agent": "backend-developer",
        "output": "API/后端代码",
        "description": "开发后端服务和API接口",
        "parallel": true
      },
      {
        "name": "前端开发",
        "agent": "frontend-developer",
        "output": "前端代码",
        "description": "开发前端页面(使用Mock数据)",
        "parallel": true
      },
      {
        "name": "前后端联调",
        "agent": "backend-developer",
        "output": "联调报告",
        "description": "前后端接口联调验证",
        "collaborators": ["frontend-developer"]
      },
      {
        "name": "代码审查",
        "agent": "code-reviewer",
        "output": "审查报告",
        "description": "审查代码质量和最佳实践"
      },
      {
        "name": "安全审计",
        "agent": "security-engineer",
        "output": "安全审计报告",
        "description": "进行安全审计和漏洞扫描",
        "requireApproval": true
      },
      {
        "name": "测试验证",
        "agent": "tester",
        "output": "测试报告",
        "description": "执行功能测试和性能测试"
      },
      {
        "name": "测试评审",
        "agent": "director",
        "output": "测试评审报告",
        "description": "评审测试结果，确认是否可上线",
        "requireApproval": true
      },
      {
        "name": "预发布部署",
        "agent": "operations",
        "output": "预发布环境",
        "description": "部署到预发布环境"
      },
      {
        "name": "预发布验证",
        "agent": "tester",
        "output": "预发布验证报告",
        "description": "在预发布环境进行验证",
        "collaborators": ["operations"]
      },
      {
        "name": "正式部署",
        "agent": "operations",
        "output": "部署结果",
        "description": "部署到生产环境并监控"
      },
      {
        "name": "上线验收",
        "agent": "director",
        "output": "验收报告",
        "description": "验收上线结果",
        "requireApproval": true
      },
      {
        "name": "文档编写",
        "agent": "tech-writer",
        "output": "技术文档",
        "description": "编写完整的技术文档和API文档"
      }
    ]
  },
  "errorHandling": {
    "retryPolicy": {
      "maxRetries": 3,
      "backoff": "exponential",
      "initialDelayMs": 1000,
      "maxDelayMs": 30000
    },
    "fallbackAgent": "director",
    "errorNotifications": true
  },
  "checkpoints": [
    {
      "stage": "需求评审",
      "requireApproval": true,
      "approvers": ["director", "requirement-analyst"]
    },
    {
      "stage": "架构设计",
      "requireApproval": true,
      "approvers": ["director", "architect"]
    },
    {
      "stage": "设计评审",
      "requireApproval": true,
      "approvers": ["director", "product-designer", "ui-designer"]
    },
    {
      "stage": "安全审计",
      "requireApproval": true,
      "approvers": ["director", "security-engineer"]
    },
    {
      "stage": "测试评审",
      "requireApproval": true,
      "approvers": ["director", "tester"]
    },
    {
      "stage": "上线验收",
      "requireApproval": true,
      "approvers": ["director"]
    }
  ],
  "notifications": {
    "onStageComplete": true,
    "onError": true,
    "onApprovalRequired": true,
    "channels": ["feishu", "email", "webhook", "in-app"],
    "templates": {
      "stage-complete": "阶段 {{stage}} 已完成，状态: {{status}}",
      "error-occurred": "错误: {{error}} 在阶段 {{stage}}",
      "approval-required": "需要审批: {{stage}}，请 {{approvers}} 处理",
      "task-assigned": "任务 {{taskName}} 已分配给 {{agent}}",
      "milestone-reached": "里程碑达成: {{milestone}}"
    },
    "rules": [
      { "event": "stage.complete", "channels": ["feishu"], "priority": "normal" },
      { "event": "error.occurred", "channels": ["feishu", "email"], "priority": "high" },
      { "event": "approval.required", "channels": ["feishu", "email"], "priority": "high" }
    ]
  },
  "taskTracking": {
    "enabled": true,
    "realtime": true,
    "skill": "./skills/task-tracker",
    "storage": {
      "backend": "file",
      "path": "./workspaces/.task-tracker",
      "autosave": true,
      "autosaveInterval": "10s"
    },
    "states": ["pending", "running", "completed", "failed", "blocked"],
    "stateTransitions": {
      "pending->running": "依赖全部完成且资源就绪",
      "running->completed|failed|blocked": "执行结果决定",
      "blocked->running": "阻塞解除后恢复",
      "failed->pending": "重试时回退",
      "completed": "终态，不可回退"
    },
    "progress": {
      "calculation": "weighted",
      "autoEstimate": true,
      "staleThreshold": "1h",
      "defaultWeight": 1
    },
    "dependency": {
      "detectCycle": true,
      "autoStart": true,
      "criticalPath": true,
      "types": ["hard", "soft", "resource"]
    },
    "history": {
      "enabled": true,
      "retention": "30d",
      "maxRecordsPerTask": 100
    },
    "report": {
      "defaultType": "progress",
      "format": "markdown",
      "timezone": "Asia/Shanghai",
      "types": ["progress", "agent", "dependency", "history", "summary"]
    },
    "integrations": {
      "smartScheduler": { "feedHistory": true, "updateEstimate": true },
      "qualityAssessor": { "triggerOnComplete": true },
      "multiProjectManager": { "shareTaskView": true },
      "notificationSystem": { "events": ["task.created", "task.completed", "task.blocked", "task.failed"] },
      "dashboardVisualizer": { "realtimeFeed": true }
    }
  },
  "agentCommunication": {
    "enabled": true,
    "modes": ["sync", "async", "broadcast", "subscribe"],
    "messageQueue": {
      "type": "in-memory",
      "maxSize": 1000,
      "ttl": 3600
    },
    "priorities": ["high", "normal", "low"]
  },
  "dashboard": {
    "enabled": true,
    "types": ["kanban", "gantt", "statistics", "workload", "workflow"],
    "realtime": true,
    "outputFormats": ["html", "mermaid", "ascii"],
    "refreshInterval": 30
  },
  "automation": {
    "testing": {
      "enabled": true,
      "types": ["unit", "integration", "api", "e2e", "performance"],
      "frameworks": ["junit", "jest", "selenium", "jmeter"],
      "coverage": {
        "enabled": true,
        "threshold": 80
      },
      "autoTrigger": true
    },
    "cicd": {
      "enabled": true,
      "stages": ["checkout", "lint", "build", "test", "security", "package", "deploy", "verify"],
      "triggers": ["push", "pull-request", "manual", "scheduled"],
      "deployStrategy": ["blue-green", "rolling", "canary"],
      "rollback": {
        "enabled": true,
        "autoRollback": true,
        "threshold": 3
      }
    }
  },
  "analytics": {
    "enabled": true,
    "dataCollection": {
      "types": ["task", "agent", "quality", "process", "resource"],
      "interval": 300
    },
    "metrics": {
      "efficiency": ["completion-rate", "avg-completion-time", "agent-utilization"],
      "quality": ["defect-rate", "test-coverage", "review-pass-rate"],
      "process": ["stage-duration", "bottleneck-identification", "approval-rate"],
      "resource": ["agent-workload", "parallel-tasks"]
    },
    "reports": ["daily", "weekly", "monthly", "quarterly"],
    "prediction": {
      "enabled": true,
      "models": ["completion-time", "resource-demand", "quality-trend"]
    },
    "anomalyDetection": true
  },
  "intelligence": {
    "smartScheduling": {
      "enabled": true,
      "strategies": ["capability-match", "load-balance", "priority", "dependency-aware", "predictive"],
      "algorithms": ["weighted-scoring", "greedy", "genetic"],
      "learning": {
        "enabled": true,
        "model": "reinforcement",
        "updateInterval": 86400
      },
      "decisionFactors": ["capability-score", "current-load", "historical-performance", "task-complexity"]
    },
    "qualityAssessment": {
      "enabled": true,
      "dimensions": ["completeness", "accuracy", "standards", "readability"],
      "scoring": {
        "range": "0-100",
        "levels": ["A", "B", "C", "D", "F"],
        "baseline": 85
      },
      "types": ["document", "code", "design", "test"],
      "autoAssess": true
    },
    "knowledgeBase": {
      "enabled": true,
      "storage": "./workspaces/knowledge-base",
      "types": ["requirement", "architecture", "design", "development", "testing", "operations"],
      "features": {
        "search": true,
        "recommend": true,
        "knowledgeGraph": true,
        "versioning": true
      },
      "autoCollect": true
    },
    "multiProject": {
      "enabled": true,
      "maxProjects": 10,
      "states": ["planning", "active", "paused", "completed", "archived"],
      "resourceAllocation": ["exclusive", "shared", "proportional"],
      "conflictResolution": ["priority", "time-slice", "resource-sharing"],
      "priorityLevels": ["critical", "high", "medium", "low"]
    }
  }
}
