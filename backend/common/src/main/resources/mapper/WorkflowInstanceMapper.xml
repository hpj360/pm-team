<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.redteam.common.mapper.WorkflowInstanceMapper">

    <!-- 结果映射 -->
    <resultMap id="WorkflowInstanceResultMap" type="com.redteam.common.entity.WorkflowInstanceEntity">
        <id     column="id"                  property="id"/>
        <result column="workflow_id"         property="workflowId"/>
        <result column="workflow_name"       property="workflowName"/>
        <result column="business_id"         property="businessId"/>
        <result column="business_type"       property="businessType"/>
        <result column="submitter_id"        property="submitterId"/>
        <result column="submitter_name"      property="submitterName"/>
        <result column="status"              property="status"/>
        <result column="current_node_id"     property="currentNodeId"/>
        <result column="current_node_name"   property="currentNodeName"/>
        <result column="current_approvers"   property="currentApprovers"/>
        <result column="created_at"          property="createdAt"/>
        <result column="updated_at"          property="updatedAt"/>
    </resultMap>

    <!-- 公共字段列 -->
    <sql id="Base_Column_List">
        id, workflow_id, workflow_name, business_id, business_type,
        submitter_id, submitter_name, status, current_node_id, current_node_name, current_approvers,
        created_at, updated_at
    </sql>

    <!-- 按业务ID+业务类型查询实例列表 -->
    <select id="selectByBusinessId" resultMap="WorkflowInstanceResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM workflow_instance
        WHERE business_id = #{businessId}
          AND business_type = #{businessType}
        ORDER BY created_at DESC
    </select>

    <!-- 按提交人ID查询实例列表 -->
    <select id="selectBySubmitter" resultMap="WorkflowInstanceResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM workflow_instance
        WHERE submitter_id = #{submitterId}
        ORDER BY created_at DESC
    </select>

    <!-- 按状态查询实例列表 -->
    <select id="selectByStatus" resultMap="WorkflowInstanceResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM workflow_instance
        WHERE status = #{status}
        ORDER BY created_at DESC
    </select>

</mapper>
